{
  "name": "pi-seshat-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Custom pi setup: Seshat the Ghola orchestrator + Honcho memory bridge + SpecSafe lifecycle",
  "type": "module",
  "scripts": {
    "test": "bun test ./.pi/extensions/**/test/*.test.ts ./.pi/skills/**/test/*.test.ts ./.omp/test/*.test.ts ./.omp/test/**/*.test.ts",
    "test:unit": "bun test --test-name-pattern='\\[unit\\]' ./.pi/extensions/**/test/*.test.ts ./.pi/skills/**/test/*.test.ts ./.omp/test/*.test.ts ./.omp/test/**/*.test.ts",
    "test:live": "HONCHO_TESTS_LIVE=1 bun test ./.pi/extensions/**/test/*.test.ts ./.pi/skills/**/test/*.test.ts ./.omp/test/*.test.ts ./.omp/test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "bun x --bun @biomejs/biome format --write .pi/extensions .pi/skills .omp/extensions .omp/hooks .omp/lib .omp/tools .omp/skills .omp/test",
    "format:check": "bun x --bun @biomejs/biome format .pi/extensions .pi/skills .omp/extensions .omp/hooks .omp/lib .omp/tools .omp/skills .omp/test",
    "lint": "bun x --bun @biomejs/biome check .pi/extensions .pi/skills .omp/extensions .omp/hooks .omp/lib .omp/tools .omp/skills .omp/test"
  },
  "dependencies": {
    "@honcho-ai/sdk": "latest",
    "@linear/sdk": "^82.1.0",
    "turndown": "^7.2.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@mariozechner/pi-coding-agent": "^0.70.2",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.0"
  }
}
