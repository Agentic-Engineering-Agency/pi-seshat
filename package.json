{
  "name": "pi-seshat-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Custom pi setup: Seshat the Ghola orchestrator + Honcho memory bridge + SpecSafe lifecycle",
  "type": "module",
  "scripts": {
    "test": "bun test ./.pi/extensions/**/test/*.test.ts ./.pi/skills/**/test/*.test.ts",
    "test:unit": "bun test --test-name-pattern='\\[unit\\]' ./.pi/extensions/**/test/*.test.ts ./.pi/skills/**/test/*.test.ts",
    "test:live": "HONCHO_TESTS_LIVE=1 bun test ./.pi/extensions/**/test/*.test.ts ./.pi/skills/**/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@honcho-ai/sdk": "latest",
    "@linear/sdk": "^82.1.0"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.2",
    "@types/bun": "latest",
    "typebox": "^1.1.24",
    "typescript": "^5.6.0"
  }
}
